#!/bin/bash
set -euo pipefail
export PATH="/usr/sbin:/usr/bin:/sbin:/bin"
PACKAGE_NAME="aic8800"
PACKAGE_VERSION="1.3.1"
case "${1:-}" in
    remove|deconfigure)
        if command -v dkms >/dev/null && dkms status -m "$PACKAGE_NAME" -v "$PACKAGE_VERSION" | grep -q .; then
            dkms remove -m "$PACKAGE_NAME" -v "$PACKAGE_VERSION" --all
        fi
        rm -rf -- "/usr/src/$PACKAGE_NAME-$PACKAGE_VERSION"
        rm -f /etc/udev/rules.d/aic.rules /usr/sbin/wifi_test /usr/sbin/bt_test
        rm -rf /lib/firmware/aic8800DC
        if command -v udevadm >/dev/null; then udevadm control --reload-rules || true; fi
        ;;
    upgrade|failed-upgrade) ;; # postinst replaces the registration after building
esac
