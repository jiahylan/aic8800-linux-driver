#!/bin/bash
set -e

KVER=$(uname -r)
SRC=/AIC8800

echo "Installing AIC8800 WiFi driver for kernel ${KVER}..."

# udev rules
cp ${SRC}/aic.rules /etc/udev/rules.d/
udevadm trigger
udevadm control --reload
echo "udev rules installed."

# eject virtual CD-ROM if present
if [ -L /dev/aicudisk ]; then
    eject /dev/aicudisk
fi

# firmware
rm -rf /lib/firmware/aic8800DC
cp -rf ${SRC}/fw/aic8800DC /lib/firmware/
echo "Firmware installed."

# compile driver
cd ${SRC}/drivers/aic8800/
make clean || true
nice -n 19 make -j4
if [ $? -ne 0 ]; then
    echo "ERROR: driver compilation failed"
    exit 1
fi
make install
if [ $? -ne 0 ]; then
    echo "ERROR: driver installation failed"
    exit 1
fi
echo "Driver compiled and installed."

# load modules
modprobe cfg80211 2>/dev/null || true
insmod ${SRC}/drivers/aic8800/aic_load_fw/aic_load_fw.ko
insmod ${SRC}/drivers/aic8800/aic8800_fdrv/aic8800_fdrv.ko
echo "Modules loaded."

# compile test tools
cd ${SRC}/aicrf_test/
make clean || true
nice -n 19 make
make install
echo "Test tools installed."

udevadm trigger
echo "AIC8800 WiFi driver installed successfully!"
exit 0