#!/bin/bash
set -e

PACKAGE_NAME="aic8800"
PACKAGE_VERSION="1.2.0"
SRC="/usr/src/${PACKAGE_NAME}-${PACKAGE_VERSION}"
FW_SRC="/AIC8800"

echo "Installing AIC8800 WiFi driver (DKMS)..."

# udev rules
cp ${FW_SRC}/aic.rules /etc/udev/rules.d/
udevadm trigger
udevadm control --reload
echo "udev rules installed."

# eject virtual CD-ROM if present
if [ -L /dev/aicudisk ]; then
    eject /dev/aicudisk
fi

# firmware
rm -rf /lib/firmware/aic8800DC
cp -rf ${FW_SRC}/fw/aic8800DC /lib/firmware/
echo "Firmware installed."

# install source to /usr/src for DKMS
if [ -d "${SRC}" ]; then
    dkms remove -m ${PACKAGE_NAME} -v ${PACKAGE_VERSION} --all 2>/dev/null || true
    rm -rf "${SRC}"
fi
mkdir -p "${SRC}"
cp -a ${FW_SRC}/drivers/aic8800/* "${SRC}/"

# register and build with DKMS
dkms add -m ${PACKAGE_NAME} -v ${PACKAGE_VERSION}
dkms build -m ${PACKAGE_NAME} -v ${PACKAGE_VERSION}
dkms install -m ${PACKAGE_NAME} -v ${PACKAGE_VERSION}
echo "DKMS modules built and installed."

# compile test tools (not kernel modules, build for running kernel only)
cd ${FW_SRC}/aicrf_test/
make clean || true
nice -n 19 make
make install
echo "Test tools installed."

udevadm trigger
echo "AIC8800 WiFi driver installed successfully!"
exit 0
